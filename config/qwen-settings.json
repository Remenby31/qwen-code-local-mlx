{
  "env": {
    "MLX_LOCAL_API_KEY": "local"
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "modelProviders": {
    "openai": [
      {
        "id": "Qwen3.8-27B-4bit",
        "name": "Qwen3.8-27B (local, MLX + speculative decoding)",
        "envKey": "MLX_LOCAL_API_KEY",
        "baseUrl": "http://127.0.0.1:8080/v1",
        "generationConfig": {
          "timeout": 600000,
          "contextWindowSize": 131072,
          "samplingParams": {
            "temperature": 1.0,
            "top_p": 0.95,
            "top_k": 20,
            "max_tokens": 16384
          }
        }
      }
    ]
  },
  "$version": 4
}
