#!/usr/bin/env bash
# Serve Qwen3.8-27B locally on Apple Silicon with speculative decoding (mlx-dspark),
# exposing an OpenAI-compatible endpoint for the Qwen Code CLI.
#
# Everything is overridable from the environment, e.g.
#   QWEN38_MODEL=mlx-community/Qwen3.8-27B-8bit qwen38-serve
#   QWEN38_MODE=baseline qwen38-serve          # no drafter, for A/B
set -euo pipefail

VENV="${QWEN38_VENV:-$HOME/.venvs/mlx-dspark}"
MODEL="${QWEN38_MODEL:-mlx-community/Qwen3.8-27B-4bit}"
PORT="${QWEN38_PORT:-8080}"
CTX="${QWEN38_CTX:-131072}"

# `auto` is deliberate. mlx-dspark >= 0.14.0 registers Qwen3.8-27B with the DFlash 2 head
# (incoai/Qwen3.8-27B-DFlash2) and picks it over DSpark on its own — measured 40.6 vs
# 31.0 tok/s here. Older versions have no DFlash entry for this target and silently fall
# back to DSpark, which is why the install script pins a minimum version.
MODE="${QWEN38_MODE:-auto}"
DRAFTER="${QWEN38_DRAFTER:-}"          # empty = let the registry resolve it

# No --kv-bits: Qwen3.8 is a hybrid Gated DeltaNet model, and only 16 of its 64 layers
# hold a real KV cache. The flag is rejected outright — and long context is cheap here
# for the same reason.
exec "$VENV/bin/mlx-dspark" serve \
  --model "$MODEL" \
  --mode "$MODE" \
  ${DRAFTER:+--drafter "$DRAFTER"} \
  --host 127.0.0.1 --port "$PORT" \
  --context-window "$CTX" \
  --prefix-cache-dir "$HOME/.cache/mlx-dspark/prefix" \
  --reasoning-effort medium \
  "$@"
